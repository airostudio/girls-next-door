# Supabase — get these from your Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth — console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth — github.com > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Magic-link email login — any standard SMTP connection string works
# (Resend, Postmark, SendGrid SMTP relay, AWS SES SMTP, Gmail SMTP, etc.)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Clarity 4K <noreply@yourdomain.com>

# Break-glass bootstrap admin — always treated as ADMIN regardless of the
# `staff` table, and usable via the password login on /auth/login. This is
# what lets you sign in on a fresh install to add the first real team member
# (Settings > Team) before anyone else exists. Keep this password strong;
# anyone with it has full access.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Everyone else who can sign in (via Google, GitHub, or a magic link) is
# managed from Settings > Team in the app itself, backed by the `staff`
# table in Supabase — nothing else to configure here.
