# Supabase — get these from your Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
# The site's own public origin — scheme + host, no trailing slash. next-auth
# resolves OAuth callbacks and magic-link URLs against this, so on a custom
# domain it MUST be that domain: Vercel's VERCEL_URL fallback is the
# per-deployment *.vercel.app host, not your domain.
#   Local:      http://localhost:3000
#   Production: https://www.girlsnextdoor.online
# Getting this wrong sends sign-in and magic links to the wrong host. Setting
# it to something that isn't this app at all (the Supabase URL, say) makes
# those redirects land there instead.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth — console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Magic-link email login. These are SMTP credentials for SENDING the login
# email — they are NOT an address you sign in with. Any standard SMTP
# connection string works (Resend, Postmark, SendGrid, AWS SES, Gmail, etc.).
# Leave them unset and the "email me a login link" option silently does
# nothing; Google and password sign-in still work.
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Girls Next Door Talent Agency <no-reply@yourdomain.com>

# Break-glass admin — the ONLY password in the system. It lives here rather
# than in the database, so there is no password column, no stored hash and
# nothing to leak or reset. Reached via the discreet "Administrator access"
# link at the bottom of /auth/login.
#
# It exists so a fresh install, an unreachable database, a broken Google
# config or an unset mail server can never lock everyone out. This address is
# also permanently treated as ADMIN regardless of the `staff` table, so it
# works through Google and magic link too.
#
# Keep this password strong; anyone with it has full access. Leave both unset
# and the recovery link disappears entirely.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Everyone else who can sign in (via Google or a one-time emailed link) is
# managed from Settings > Team in the app itself, backed by the `staff`
# table in Supabase — nothing else to configure here. Staff never have
# passwords.
